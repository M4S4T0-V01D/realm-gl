{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [],
    "resolveJsonModule": true
  },
  "include": [
    "games/**/*.ts",
    "games/**/*.tsx",
    "host/**/*.ts",
    "host/**/*.tsx",
    "cloud/**/*.ts",
    "site/**/*.ts",
    "types.d.ts"
  ]
}