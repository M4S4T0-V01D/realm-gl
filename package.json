{
  "name": "rarefriends-realm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RareFriends Realm: an old-school 2.5D isometric RPG with skills, quests and a large world, for the Rare Friends Vibeathon (FriendSDK v0.1.4)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --dev",
    "dev:lan": "node scripts/build.mjs --dev --host 0.0.0.0 --port 4173",
    "build": "node scripts/build.mjs",
    "check": "friendsdk check ./games/rarefriends-realm",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs && node tests/multiplayer-browser.mjs && node tests/cloud-browser.mjs && node tests/preview-browser.mjs",
    "build:preview": "node scripts/build-preview.mjs"
  },
  "dependencies": {
    "@rarefriends/friendsdk": "file:vendor/rarefriends-friendsdk-0.1.4.tgz",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "trystero": "^0.25.4",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3"
  }
}
